# --- Supabase (progetto DEDICATO, non quello di RETI CRM) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo server: serve al webhook Stripe per aggiornare gli abbonamenti. Mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (co-conduzione, contenuti, reel) ---
ANTHROPIC_API_KEY=

# --- Stripe (abbonamenti) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=

# URL pubblico dell'app (per i redirect di Stripe), es. https://luce.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Meta (analisi profilo da link, Business Discovery API) ---
# Token di lunga durata di un account Instagram professionale della piattaforma e il suo id.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0
